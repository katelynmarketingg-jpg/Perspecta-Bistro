{
  "rules": {
    "public": {
      ".read": true,
      "$key": {
        ".write": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1' || ($key.beginsWith('slug__') && newData.val() === auth.token.storeId && (!data.exists() || data.val() === auth.token.storeId)))"
      }
    },
    "photos": {
      ".read": true,
      "$key": {
        ".write": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1')"
      }
    },
    "orders": {
      "$key": {
        ".read": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1')",
        ".write": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1')"
      }
    },
    "data": {
      "$key": {
        ".read": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1')",
        ".write": "auth != null && (auth.token.role === 'gestor' || $key === 'gestaoCompany_' + auth.token.storeId + '_v1')"
      }
    }
  }
}
